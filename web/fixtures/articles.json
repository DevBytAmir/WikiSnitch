  "sql": [
    {
      "label": "Articles, history first",
      "statement": "SELECT a.lang, a.page_id, a.title, a.wikidata_id, (h.page_id IS NOT NULL) AS has_history FROM article a LEFT JOIN article_history h ON a.lang = 'fi' AND h.page_id = a.page_id WHERE ? = 0 OR h.page_id IS NOT NULL ORDER BY has_history DESC, a.title LIMIT ?"
    },
    {
      "label": "Versions per article",
      "statement": "SELECT page_id, COUNT(*) AS versions FROM article_history FOR SYSTEM_TIME ALL WHERE page_id IN (?, ?) GROUP BY page_id"
    },
    {
      "label": "Same topic in other languages",
      "statement": "SELECT wikidata_id, lang, page_id, title FROM article WHERE wikidata_id IN (?, ?, ?) ORDER BY lang, page_id"
    }
  ]
