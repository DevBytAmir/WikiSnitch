# Copy this file to .env. The code and docker-compose.yml both read it.
# Real environment variables override these values.

# MariaDB (container on the host port below)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=wikisnitch
DB_PASSWORD=wikisnitch
DB_ROOT_PASSWORD=wikisnitch
DB_NAME=wikisnitch
# How many candidates the vector index examines per search (higher is slower and more accurate).
DB_VECTOR_SEARCH_DEPTH=80

# Embeddings. EMBEDDER selects the provider:
#   ollama  a local Ollama server, EMBED_BASE_URL is its address
#   openai  any service with an OpenAI-compatible /embeddings endpoint, hosted or local;
#           EMBED_BASE_URL is its API root and EMBED_API_KEY its key
#   fake    deterministic vectors for tests, no server needed
# EMBED_DIMENSIONS must match the VECTOR column in db/schema.sql. Vectors from different models
# are not comparable, so changing the model means embedding every text again.
EMBEDDER=ollama
EMBED_BASE_URL=http://localhost:11434
EMBED_MODEL=bge-m3
EMBED_API_KEY=
EMBED_DIMENSIONS=1024

# Where downloaded datasets live (git-ignored).
DATA_DIR=data

# Answer model, optional: any OpenAI-compatible endpoint. Leave empty to answer without a model.
LLM_ASK_BASE_URL=
LLM_ASK_MODEL=
LLM_ASK_API_KEY=
LLM_ASSESS_BASE_URL=
LLM_ASSESS_MODEL=
LLM_ASSESS_API_KEY=
